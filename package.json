{
  "name": "spectre-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8000 --live-reload",
    "build": "node scripts/build-worker.mjs",
    "build:pages": "python3 scripts/build-pages.py",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply spectre-reservations --local",
    "telegram:setup": "node scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "wrangler": "4.131.0"
  }
}
